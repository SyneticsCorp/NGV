        <mxCell id="bnd_core" value="core 영역 — 컴포넌트 기반 + 모니터-액추에이터 (IU-0009 허브-스포크, Phase2: IU-0010~0013 신규 리프 추가, Phase3: IU-0014~0016 신규 리프 추가)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#C00000;fillColor=#FFFFFF;fontColor=#595959;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="1360" height="600" as="geometry"/></mxCell>

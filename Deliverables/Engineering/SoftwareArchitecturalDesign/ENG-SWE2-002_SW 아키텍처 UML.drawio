        <mxCell id="bnd_adapter" value="어댑터 계층 — Ports &amp; Adapters 외곽 (1차/구동측, 2차/구동됨측)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#2F75B5;fillColor=#F5F9FD;fontColor=#595959;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1740" height="300" as="geometry"/></mxCell>
        <mxCell id="bnd_core" value="core 영역 — 컴포넌트 기반 + 모니터-액추에이터 (ASIL 혼재, 5장 허브-스포크 의존 구조). 2행: 위 Phase 1(ARC-0002~0005), 아래 Phase 2 신규(ARC-0010~0013)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#C00000;fillColor=#FFFFFF;fontColor=#595959;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1740" height="580" as="geometry"/></mxCell>
